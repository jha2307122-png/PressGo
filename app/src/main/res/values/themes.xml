<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =====================================================
         Base Application Theme
         ===================================================== -->
    <style name="Theme.PressGo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color scheme -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Material3 color roles -->
        <item name="colorPrimaryContainer">@color/primary_surface</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondaryContainer">@color/accent_light</item>
        <item name="colorOnSecondaryContainer">@color/secondary_variant</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/error_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOutline">@color/border</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Shape appearances -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.PressGo.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PressGo.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PressGo.LargeComponent</item>

        <!-- Material component overrides -->
        <item name="materialButtonStyle">@style/Widget.PressGo.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.PressGo.Button.Outlined</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.PressGo.ExtendedFAB</item>
        <item name="floatingActionButtonStyle">@style/Widget.PressGo.FAB</item>
        <item name="chipStyle">@style/Widget.PressGo.Chip</item>
        <item name="chipGroupStyle">@style/Widget.PressGo.ChipGroup</item>
        <item name="materialCardViewStyle">@style/Widget.PressGo.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.PressGo.BottomNavigation</item>
        <item name="textInputStyle">@style/Widget.PressGo.TextInputLayout</item>

        <!-- Text appearances -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.PressGo.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.PressGo.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.PressGo.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PressGo.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PressGo.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.PressGo.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PressGo.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PressGo.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.PressGo.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PressGo.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.PressGo.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.PressGo.LabelSmall</item>

        <!-- Window transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/fade</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
    </style>

    <!-- =====================================================
         Splash Theme (full-screen, no action bar)
         ===================================================== -->
    <style name="Theme.PressGo.Splash" parent="Theme.PressGo">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- =====================================================
         No Action Bar variant
         ===================================================== -->
    <style name="Theme.PressGo.NoActionBar" parent="Theme.PressGo">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- =====================================================
         Auth Theme (light status bar for login screens)
         ===================================================== -->
    <style name="Theme.PressGo.Auth" parent="Theme.PressGo">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- =====================================================
         Dialog Theme
         ===================================================== -->
    <style name="Theme.PressGo.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PressGo.MediumComponent</item>
    </style>

    <!-- =====================================================
         Shape Appearances
         ===================================================== -->
    <style name="ShapeAppearance.PressGo.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.PressGo.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.PressGo.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.PressGo.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- =====================================================
         Text Appearances
         ===================================================== -->
    <style name="TextAppearance.PressGo.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PressGo.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PressGo.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PressGo.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PressGo.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.PressGo.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.PressGo.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.PressGo.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.PressGo.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.PressGo.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.PressGo.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.PressGo.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.PressGo.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.PressGo.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.PressGo.Price" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.PressGo.StatusBadge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- =====================================================
         Widget Styles — Button
         ===================================================== -->
    <style name="Widget.PressGo.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:textAppearance">@style/TextAppearance.PressGo.LabelLarge</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PressGo.SmallComponent</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="Widget.PressGo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="android:textAppearance">@style/TextAppearance.PressGo.LabelLarge</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PressGo.SmallComponent</item>
    </style>

    <style name="Widget.PressGo.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.PressGo.LabelLarge</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.PressGo.Button.Danger" parent="Widget.PressGo.Button">
        <item name="backgroundTint">@color/error</item>
        <item name="android:textColor">@color/on_error</item>
    </style>

    <!-- =====================================================
         Widget Styles — FAB
         ===================================================== -->
    <style name="Widget.PressGo.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
        <item name="elevation">@dimen/fab_elevation</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PressGo.MediumComponent</item>
    </style>

    <style name="Widget.PressGo.ExtendedFAB" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="tint">@color/on_primary</item>
        <item name="elevation">@dimen/fab_elevation</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PressGo.SmallComponent</item>
    </style>

    <!-- =====================================================
         Widget Styles — Card
         ===================================================== -->
    <style name="Widget.PressGo.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.PressGo.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- =====================================================
         Widget Styles — Bottom Navigation
         ===================================================== -->
    <style name="Widget.PressGo.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="elevation">@dimen/bottom_nav_elevation</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.PressGo.BottomNavigation.ActiveIndicator</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.PressGo.BottomNav</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.PressGo.BottomNav.Active</item>
    </style>

    <style name="Widget.PressGo.BottomNavigation.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <style name="TextAppearance.PressGo.BottomNav" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PressGo.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- =====================================================
         Widget Styles — Chip
         ===================================================== -->
    <style name="Widget.PressGo.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_default</item>
        <item name="chipStrokeColor">@color/border_light</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/corner_radius_chip</item>
        <item name="android:textColor">@color/chip_text_default</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="Widget.PressGo.ChipGroup" parent="Widget.Material3.ChipGroup">
        <item name="chipSpacingHorizontal">8dp</item>
        <item name="chipSpacingVertical">4dp</item>
    </style>

    <!-- =====================================================
         Widget Styles — TextInputLayout
         ===================================================== -->
    <style name="Widget.PressGo.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="errorTextColor">@color/error</item>
    </style>

    <style name="Widget.PressGo.TextInputLayout.FilledBox" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxBackgroundColor">@color/surface_variant</item>
    </style>

    <!-- =====================================================
         Widget Styles — Toolbar / AppBar
         ===================================================== -->
    <style name="Widget.PressGo.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.PressGo.TitleLarge</item>
        <item name="android:elevation">@dimen/toolbar_elevation</item>
        <item name="titleTextColor">@color/on_primary</item>
    </style>

    <style name="Widget.PressGo.Toolbar.Surface" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="android:elevation">@dimen/toolbar_elevation</item>
    </style>

    <!-- =====================================================
         Widget Styles — Tab Layout
         ===================================================== -->
    <style name="Widget.PressGo.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabTextAppearance">@style/TextAppearance.PressGo.LabelMedium</item>
        <item name="tabBackground">@color/surface</item>
    </style>

    <!-- =====================================================
         Widget Styles — Switch
         ===================================================== -->
    <style name="Widget.PressGo.Switch" parent="Widget.Material3.CompoundButton.Switch">
    </style>

    <!-- =====================================================
         Progress Bar
         ===================================================== -->
    <style name="Widget.PressGo.ProgressBar.Linear" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/secondary</item>
        <item name="android:progressBackgroundTint">@color/progress_track</item>
        <item name="android:minHeight">@dimen/progress_bar_height</item>
        <item name="android:maxHeight">@dimen/progress_bar_height</item>
    </style>

    <style name="Widget.PressGo.ProgressBar.Circular" parent="Widget.AppCompat.ProgressBar">
        <item name="colorAccent">@color/primary</item>
    </style>

    <!-- =====================================================
         Snackbar
         ===================================================== -->
    <style name="Widget.PressGo.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/primary_variant</item>
        <item name="snackbarTextViewStyle">@style/Widget.PressGo.SnackbarText</item>
        <item name="snackbarButtonStyle">@style/Widget.PressGo.SnackbarButton</item>
    </style>

    <style name="Widget.PressGo.SnackbarText" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.PressGo.SnackbarButton" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- =====================================================
         Dialog
         ===================================================== -->
    <style name="Widget.PressGo.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PressGo.LargeComponent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PressGo.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PressGo.Button.Text</item>
    </style>

    <!-- =====================================================
         List / RecyclerView
         ===================================================== -->
    <style name="Widget.PressGo.ListItem" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">@dimen/list_item_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/list_item_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/list_item_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/list_item_padding_vertical</item>
        <item name="android:minHeight">@dimen/list_item_height</item>
    </style>

    <!-- =====================================================
         Empty State
         ===================================================== -->
    <style name="Widget.PressGo.EmptyStateTitle" parent="TextAppearance.PressGo.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.PressGo.EmptyStateDesc" parent="TextAppearance.PressGo.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

</resources>
