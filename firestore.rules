rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    function isStaff() {
      return isAuthenticated() && (getUserData().role == 'STAFF' || getUserData().role == 'ADMIN');
    }

    function isShopStaff(shopId) {
      return isAuthenticated() && (isAdmin() || (getUserData().role == 'STAFF' && getUserData().shopId == shopId));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Campus Printing Shops
    match /shops/{shopId} {
      allow read, write: if true;
    }

    // Shop Pricing Configurations
    match /shopPricing/{shopId} {
      allow read, write: if true;
    }
    match /shop_pricing/{shopId} {
      allow read, write: if true;
    }

    // Print Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isShopStaff(resource.data.shopId)
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Customer can cancel if pending
        (resource.data.customerId == request.auth.uid && request.resource.data.orderStatus == 'CANCELLED' && (resource.data.orderStatus == 'PENDING' || resource.data.orderStatus == 'ACCEPTED')) ||
        // Staff can update status, printer, notes
        isShopStaff(resource.data.shopId)
      );
      allow delete: if isAdmin();

      // Order files subcollection
      match /orderFiles/{fileId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Printers
    match /printers/{printerId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Inventory Items
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || isStaff()
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isStaff();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated();
    }

    // Conversion History
    match /conversion_history/{historyId} {
      allow read, write: if true;
    }
    match /conversionHistory/{historyId} {
      allow read, write: if true;
    }

    // Compression History
    match /compression_history/{historyId} {
      allow read, write: if true;
    }
  }
}
